{
  "name": "siliconsentinel-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/gen-validators.mjs && tsc --noEmit && vite build",
    "test": "playwright test",
    "types": "openapi-typescript ../contracts/openapi.json -o src/api.d.ts",
    "pretest": "npm run build",
    "types:check": "node scripts/check-types.mjs",
    "contracts": "cd .. && uv run python scripts/generate_contracts.py && cd web && npm run types"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "ajv": "^8.17.1"
  }
}
