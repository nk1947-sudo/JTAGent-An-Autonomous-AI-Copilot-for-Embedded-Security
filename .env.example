# Default offline demonstration; no paid calls or debugger connection.
TARGET_BACKEND=mock
INFERENCE_BACKEND=scripted
MAX_READ_BYTES=4096
# Local launcher generates these if omitted. Set unique secrets for separate processes.
# EDGE_API_KEY=
# DASHBOARD_PASSWORD=
EDGE_API_URL=http://127.0.0.1:8001
COOKIE_SECURE=0
PUBLIC_ORIGIN=http://127.0.0.1:8000
# REDACT_VALUES=value-one|value-two
# Replay is independent of inference:
# TARGET_BACKEND=replay
# REPLAY_MANIFEST=fixtures/replay.json
# Live hardware requires a reviewed operator profile; demo addresses are NOT hardware authorization:
# TARGET_BACKEND=openocd
# TARGET_PROFILE=/absolute/path/to/operator-profile.json
# OPENOCD_TARGET=am335x.cpu
# OPENOCD_PORT=6666
# OPENOCD_VERSION_PREFIX=Open On-Chip Debugger 0.12.
# ARM_SNAPSHOTS=1
# Paid inference requires explicit account/hosted-limit verification:
# INFERENCE_BACKEND=nebius
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_API_KEY=
# NEBIUS_VERIFIED_CONTEXT_TOKENS=
# NEBIUS_MAX_OUTPUT_TOKENS=2048
