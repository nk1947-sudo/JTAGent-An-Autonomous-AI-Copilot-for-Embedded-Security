# Default offline demonstration; no paid calls or debugger connection.
TARGET_BACKEND=mock
INFERENCE_BACKEND=scripted
MAX_READ_BYTES=4096
# Local launcher generates these if omitted. Set unique secrets for separate processes.
# EDGE_API_KEY=
# DASHBOARD_PASSWORD=
EDGE_API_URL=http://127.0.0.1:8001
COOKIE_SECURE=0
PUBLIC_ORIGIN=http://127.0.0.1:8000
# Optional web search and LangSmith observability credentials.
TAVILY_API_KEY=
LANGSMITH_API_KEY=
# REDACT_VALUES=value-one|value-two
# Replay is independent of inference:
# TARGET_BACKEND=replay
# REPLAY_MANIFEST=fixtures/replay.json
# Live hardware requires a reviewed operator profile; demo addresses are NOT hardware authorization:
# TARGET_BACKEND=openocd
# TARGET_PROFILE=/absolute/path/to/operator-profile.json
# OPENOCD_TARGET=am335x.cpu
# OPENOCD_PORT=6666
# OPENOCD_VERSION_PREFIX=Open On-Chip Debugger 0.12.
# ARM_SNAPSHOTS=1
# UART auditing is local-only and executes fixed checks; credentials never enter prompts or reports:
# UART_AUDIT_ENABLED=1
# UART_PORT=COM12
# UART_BAUD=115200
# UART_AUDIT_USERNAME=
# UART_AUDIT_PASSWORD=
# Paid inference requires explicit account/hosted-limit verification:
# INFERENCE_BACKEND=nebius
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_API_KEY=
# NEBIUS_VERIFIED_CONTEXT_TOKENS=
# NEBIUS_MAX_OUTPUT_TOKENS=2048
# Optional display-only pricing used to estimate each dashboard run's cost:
# NEBIUS_INPUT_USD_PER_MILLION=
# NEBIUS_OUTPUT_USD_PER_MILLION=

# Explicit opt-in for the Attack Lab's real, restore-on-exit OpenOCD snapshot probe.
# This does not enable writes, firmware patches, glitch pulses, or arbitrary commands.
ATTACK_LAB_LIVE_JTAG=0
# Local evidence export: the edge keeps raw target bytes in memory only when 1 (never sent to a model).
# RETAIN_RAW_LOCAL=0
# Where evidence bundles are written (default ./exports).
# EXPORT_DIR=
